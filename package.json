{
  "name": "@nxtedition/rocksdb",
  "version": "17.1.1",
  "description": "A low-level Node.js RocksDB binding",
  "bugs": {
    "url": "https://github.com/nxtedition/rocks-level/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nxtedition/rocks-level.git"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json",
    "build-deps": "node scripts/build-deps.js",
    "install": "node scripts/install.js",
    "prebuildify": "node scripts/prebuildify.js",
    "prepare": "npm run build",
    "rebuild": "node scripts/install.js --build-from-source",
    "release": "./release.sh",
    "test": "standard && npm run typecheck && npm run build && npm run test:types && (nyc -s tape test/*-test.js | faucet) && nyc report && npm run test-gc",
    "test:close-faults": "cross-env-shell ROCKS_LEVEL_TEST_FAULTS=1 \"npm run rebuild && tape test/close-error-lifetime-test.js test/close-error-native-fault-test.js\"",
    "test:native-faults": "cross-env-shell ROCKS_LEVEL_TEST_FAULTS=1 \"npm run rebuild && tape test/native-completion-exception-fault-test.js test/io-uring-native-fault-test.js\"",
    "test:types": "tsc -p test/tsconfig.json",
    "test-gc": "node --expose-gc test/gc.js",
    "test-prebuild": "cross-env PREBUILDS_ONLY=1 npm t",
    "typecheck": "tsc -p tsconfig.json"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-sh",
      "prettier-plugin-packagejson"
    ],
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@nxtedition/slice": "^2.0.0",
    "abstract-level": "^3.1.1",
    "catering": "^2.1.1",
    "module-error": "^1.0.2",
    "napi-macros": "~2.2.2",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "du": "^1.0.0",
    "faucet": "^0.0.4",
    "lru-cache": "^11.2.5",
    "mitata": "^1.0.10",
    "node-gyp": "^13.0.1",
    "nyc": "^18.0.0",
    "prebuildify": "^6.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.18.1",
    "rimraf": "^6.1.3",
    "standard": "^17.1.2",
    "tape": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "gypfile": true,
  "standard": {
    "ignore": [
      "deps/*"
    ]
  }
}
