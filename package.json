{
  "name": "@nxtedition/rocksdb",
  "version": "16.0.10",
  "description": "A low-level Node.js RocksDB binding",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "install": "node scripts/install.js",
    "build-deps": "node scripts/build-deps.js",
    "test": "standard && npm run test:types && (nyc -s tape test/*-test.js | faucet) && nyc report && npm run test-gc",
    "test:native-faults": "cross-env-shell ROCKS_LEVEL_TEST_FAULTS=1 \"npm run rebuild && tape test/native-completion-exception-fault-test.js\"",
    "test:close-faults": "cross-env-shell ROCKS_LEVEL_TEST_FAULTS=1 \"npm run rebuild && tape test/close-error-lifetime-test.js test/close-error-native-fault-test.js\"",
    "test:types": "tsc -p test/tsconfig.json",
    "test-gc": "node --expose-gc test/gc.js",
    "test-prebuild": "cross-env PREBUILDS_ONLY=1 npm t",
    "prebuildify": "node scripts/prebuildify.js",
    "rebuild": "node scripts/install.js --build-from-source",
    "release": "./release.sh"
  },
  "dependencies": {
    "@nxtedition/slice": "^2.0.0",
    "abstract-level": "^1.0.2",
    "catering": "^2.1.1",
    "module-error": "^1.0.2",
    "napi-macros": "~2.2.2",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "du": "^1.0.0",
    "faucet": "^0.0.4",
    "lru-cache": "^11.2.5",
    "mitata": "^1.0.10",
    "node-gyp": "^13.0.1",
    "nyc": "^18.0.0",
    "prebuildify": "^6.0.1",
    "standard": "^17.1.2",
    "tape": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "standard": {
    "ignore": [
      "deps/*"
    ]
  },
  "gypfile": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nxtedition/rocks-level.git"
  },
  "bugs": {
    "url": "https://github.com/nxtedition/rocks-level/issues"
  }
}
