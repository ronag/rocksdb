# NOTE: ineffective, kept so it starts working if upstream ever drops the
# negation. rocksdb's own .gitignore ends with `!docs/` + `!docs/**`, and
# npm-packlist applies a nested ignore file *after* the parent's rules, so that
# negation re-includes docs/ (~10 MB of Jekyll site and PNGs) no matter what we
# write here. Excluding it needs a `.npmignore` inside the submodule itself.
deps/rocksdb/rocksdb/docs/

# Programs and build systems we never compile. rocksdb.gyp lists its sources
# explicitly (every tools/ and db_stress_tool/ entry is commented out) and none
# of these are in the include closure of the 360 sources it does build.
deps/rocksdb/rocksdb/tools/
deps/rocksdb/rocksdb/db_stress_tool/
deps/rocksdb/rocksdb/c_api_gen/
deps/rocksdb/rocksdb/microbench/
deps/rocksdb/rocksdb/unreleased_history/
deps/rocksdb/rocksdb/githooks/
deps/rocksdb/rocksdb/cmake/
deps/rocksdb/rocksdb/BUCK
deps/rocksdb/rocksdb/Directory.Build.props
deps/rocksdb/rocksdb/ccache_msvc_compiler.bat
deps/rocksdb/rocksdb/thirdparty.inc
deps/rocksdb/rocksdb/crash_test.mk
deps/rocksdb/rocksdb/folly.mk

# Tests and benchmarks left in the source dirs we do compile. Note `*_test.c`
# is a separate rule from `*_test.cc`: db/c_test.c (274 KB) is the only one, and
# it hid behind the extension for years. Deliberately narrow — test_util/ holds
# transaction_test_util.cc and testutil.cc, which rocksdb.gyp does compile.
deps/rocksdb/rocksdb/**/*_test.cc
deps/rocksdb/rocksdb/**/*_test.c
deps/rocksdb/rocksdb/**/*_bench.cc
deps/rocksdb/rocksdb/**/*_bench_tool.cc

deps/snappy/snappy*/testdata/
deps/snappy/snappy*/*.txt
deps/snappy/snappy*/README.md

