*.csv

# Dot-directories are local tooling only (agent worktrees, editor/CI config,
# caches). Publishing one leaks whatever an untracked tool dropped in the
# working tree, so exclude every directory whose name starts with a dot at any
# depth. Dot-files (.editorconfig, deps' .clang-tidy, .gitkeep) still publish.
.*/

# Redundant with the rule above, but kept explicit so the private scratch
# workspaces AI coding agents create (.codex-private/, .claude-private/, ...)
# stay excluded even if `.*/` is ever narrowed.
.*-private/

# Misc
yarn.lock
.gitmodules
.travis.yml
appveyor.yml
.appveyor.yml
Dockerfile
.dockerignore
# Maintainer-only release plumbing: build.sh drives the Docker prebuild (and the
# Dockerfile it needs is excluded above), release.sh publishes. Anchored, so a
# vendored deps/*/build.sh would still ship.
/build.sh
/release.sh
Vagrantfile
.arcconfig
.clang-format
.watchmanconfig

