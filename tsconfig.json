{
  "compilerOptions": {
    "lib": ["esnext"],
    "module": "NodeNext",
    "target": "esnext",
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src"]
}
